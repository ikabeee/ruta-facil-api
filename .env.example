# ==========================================
# CONFIGURACIÓN DE DESARROLLO - RUTA FÁCIL
# ==========================================

# Configuración del contenedor
CONTAINER_NAME=app
CONTAINER_PORT=3000
ORIGIN_PORT=5173

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${DATABASE_NAME}?schema=public"

# Configuración de correo electrónico
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_email_password
DEFAULT_FROM_EMAIL=noreply@rutafacil.com

# Configuración JWT
JWT_SECRET=your_jwt_secret_key_here_make_it_long_and_secure
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# URLs y dominios
FRONTEND_URL=http://localhost:5173

# Configuración de entorno
NODE_ENV=development
COOKIE_DOMAIN=localhost

# ==========================================
# CONFIGURACIÓN DE GOOGLE OAUTH
# ==========================================
# Para obtener estas credenciales:
# 1. Ir a https://console.cloud.google.com/
# 2. Crear proyecto o seleccionar existente
# 3. Habilitar Google+ API
# 4. Crear credenciales OAuth 2.0
# 5. Configurar URLs autorizadas

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:7000/api/v1/auth/google/callback

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. Nunca subir el archivo .env al repositorio
# 2. Usar valores seguros en producción
# 3. El JWT_SECRET debe ser una cadena larga y aleatoria
# 4. Configurar GOOGLE_CLIENT_ID y GOOGLE_CLIENT_SECRET para OAuth
# 5. Ajustar URLs según el entorno (desarrollo/producción)