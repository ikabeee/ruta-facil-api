# Copiar este archivo a .env y configurar con tus valores reales

# Base de datos PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_NAME=postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres?schema=public"

# Configuración JWT
JWT_SECRET=super_secret_jwt_key_for_development_only_change_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# URLs y dominios
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
COOKIE_DOMAIN=localhost

# Configuración de correo (opcional para OAuth)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_email_password
DEFAULT_FROM_EMAIL=noreply@rutafacil.com

# ==========================================
# CONFIGURACIÓN DE GOOGLE OAUTH
# ==========================================
# ⚠️  IMPORTANTE: Configurar estas variables para que OAuth funcione
# 1. Ir a https://console.cloud.google.com/
# 2. Crear proyecto y habilitar Google+ API
# 3. Crear credenciales OAuth 2.0
# 4. Reemplazar los valores a continuación

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:7000/api/v1/auth/google/callback
